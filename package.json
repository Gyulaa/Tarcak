{
  "name": "tarcak",
  "version": "1.0.0",
  "description": "Local-first personal finance app (Expo / React Native)",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gyulaa/Tarcak.git"
  },
  "bugs": {
    "url": "https://github.com/Gyulaa/Tarcak/issues"
  },
  "homepage": "https://github.com/Gyulaa/Tarcak#readme",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:localhost": "expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc --noEmit -p tsconfig.src.json",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/resolve-ts.mjs --test \"tests/**/*.test.ts\"",
    "test:jar": "node scripts/jar-advanced-chart-selftest.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "style:scan": "node scripts/style-scan.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "expo": "~55.0.32",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.18",
    "expo-screen-capture": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/invariant": "^2.2.37",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "zod": "^4.6.7"
  }
}
